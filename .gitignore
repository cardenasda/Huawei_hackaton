node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/
.pnp.*
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml
# Build outputs de frontend
.next/
out/
.cache/
.parcel-cache/
.turbo/
.vercel/

