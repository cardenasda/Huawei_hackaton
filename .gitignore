# ============================================================================
# .gitignore — Huawei Hackathon / FlowMatch Assignment Engine (Reto 2)
# Metodología de desarrollo limpia: evita subir archivos innecesarios o sensibles
# ============================================================================

# ----------------------------------------------------------------------------
# SECRETS Y ARCHIVOS SENSIBLES  (NUNCA subir al repositorio)
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
*.env
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
token.txt
*_token.*
*secret*
*.keystore
service-account*.json
# Huawei Cloud / MaaS credentials
huawei_credentials*
*.ak
*.sk

# ----------------------------------------------------------------------------
# PYTHON
# ----------------------------------------------------------------------------
# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib

# Distribución / packaging
build/
dist/
wheels/
*.egg
*.egg-info/
*.egg-link
develop-eggs/
sdist/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
.python-version

# Cache de herramientas Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.cache/

# Type stubs / pyright
.pytyped/
pyrightconfig.json

# ----------------------------------------------------------------------------
# JUPYTER NOTEBOOKS
# ----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
# Mantener notebooks .ipynb (útiles para la Fase 4), pero ignorar checkpoints

# ----------------------------------------------------------------------------
# STREAMLIT / DASH / FLASK / FASTAPI  (interfaz Fase 4)
# ----------------------------------------------------------------------------
.streamlit/
__streamlit__/
instance/
flask_session/

# ----------------------------------------------------------------------------
# NODE.JS / FRONTEND  (por si la UI web usa JS)
