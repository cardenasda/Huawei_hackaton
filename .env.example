# ============================================================================
# .env.example — Plantilla de variables de entorno (NO contiene secrets reales)
# Copiar a .env y llenar con valores reales:  cp .env.example .env
# El archivo .env está ignorado por .gitignore y NUNCA debe subirse al repo.
# ============================================================================

# --- Huawei Cloud / MaaS Credentials ---
# Credenciales para acceder al modelo GLM 5.2 vía MaaS
HUAWEI_AK=your_access_key_here
HUAWEI_SK=your_secret_key_here
HUAWEI_PROJECT_ID=your_project_id_here
HUAWEI_REGION=cn-east-3

# --- Endpoint del modelo (GLM 5.2) ---
# URL base del endpoint del modelo en MaaS
GLM_ENDPOINT=https://your-maas-endpoint.com/v1
GLM_MODEL=glm-5.2

# --- Configuración del servicio FlowMatch ---
# Puerto donde corre la API / interfaz
FLOWMATCH_PORT=8000
# Modo: development | production
FLOWMATCH_ENV=development
# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# --- Servicio de tarifa dinámica (mock) ---
# Probabilidad de fallo del servicio mock (0.0 - 1.0)
PRICING_FAILURE_RATE=0.3
# Timeout del servicio de tarifa en segundos
PRICING_TIMEOUT=2
# Tarifa base fija (COP) usada cuando el circuit breaker está abierto
PRICING_FLAT_RATE_FALLBACK=5000
